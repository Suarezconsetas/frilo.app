# Copia a .env.local y completa. Nunca subas claves al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (tarea diaria de TRM, alertas)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM="Frilo <hola@tudominio.com>"
# Pon true cuando Google esté activado en Supabase (Authentication → Providers → Google)
NEXT_PUBLIC_GOOGLE_ACTIVO=false
# Largo del código por correo: debe coincidir con Supabase (Authentication → Email → OTP length). Por defecto 6.
NEXT_PUBLIC_LARGO_CODIGO=6
# Dirección pública de la app (para las vistas previas al compartir). Cámbiala al dominio propio.
NEXT_PUBLIC_APP_URL=https://frilo.dev
